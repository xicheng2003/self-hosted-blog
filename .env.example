# Public site URL used by metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_APP_URL="https://blog.example.com"

# Email subscription and newsletter delivery. Keep all values except
# NEXT_PUBLIC_* on the server only.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="AuraDawn Blog <letters@updates.example.com>"
RESEND_REPLY_TO="me@example.com"
RESEND_SEGMENT_ID="seg_xxxxxxxxx"
RESEND_TOPIC_ID="topic_xxxxxxxxx"
SUBSCRIBE_SECRET="replace-with-at-least-32-random-bytes"

# Optional: use this only when the form posts to a separately deployed function.
# NEXT_PUBLIC_SUBSCRIBE_ENDPOINT="https://functions.example.com/api/subscribe"

# Optional: only needed when running `npm run content:export` against the
# previous PostgreSQL + S3 installation. The public site does not read these.
DATABASE_URL="postgresql://user:password@host:5432/database"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="blog-images"
S3_REGION="us-east-1"
S3_PUBLIC_DOMAIN="https://assets.example.com"
